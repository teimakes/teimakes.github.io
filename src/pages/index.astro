---
import Base from '../layouts/Base.astro';
import FeedSubscribe from '../components/FeedSubscribe.astro';
import PostCard from '../components/PostCard.astro';

const postImportResult = import.meta.glob('./posts/*.{md,mdx}', { eager: true });
const posts = Object.values(postImportResult)
  .filter((p: any) => !p.frontmatter.draft)
  .sort((a: any, b: any) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---

<Base>
  <section class="hero">
    <h1>AI, LLMs & Creative Experiments</h1>
    <p>I'm Taieui Song. I write about AI — LLMs, agents, and the weird new world of AI movies, animation and manga.</p>
  </section>

  <section aria-labelledby="start-here" class="prose">
    <h2 id="start-here" class="section-title">Start here · 처음 읽을 글</h2>
    <ul lang="ko">
      <li><a href="/posts/nlp-before-llms-ko/">LLM 이전의 자연어 처리부터 시작하기</a></li>
      <li><a href="/posts/attention-01-big-picture-ko/">어텐션과 트랜스포머: PyTorch 실습 시리즈</a></li>
      <li><a href="/posts/full-context-vs-rag-ko/">Full Context와 RAG 비교 실험</a></li>
    </ul>
  </section>
  <h2 class="section-title">Latest Posts</h2>
  <div class="post-list">
    {posts.map((p: any) => (
      <PostCard
        title={p.frontmatter.title}
        description={p.frontmatter.description}
        date={new Date(p.frontmatter.date)}
        url={p.url}
        tags={p.frontmatter.tags}
      />
    ))}
  </div>

  <FeedSubscribe />
</Base>
