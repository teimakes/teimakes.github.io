---
import { SITE } from '../config';
import { canonicalPath, pageLanguage, translations } from '../lib/seo';
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  article?: { date: string; updatedDate?: string; tags?: string[] };
  noindex?: boolean;
}
const { title, description = SITE.description, lang = pageLanguage(Astro.url.pathname), canonical, article, noindex = false } = Astro.props;
const site = Astro.site!;
const url = new URL(canonicalPath(canonical || Astro.url.pathname), site).href;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — AI, LLMs & Creative Experiments`;
const alternates = noindex || canonical ? [] : translations(Astro.url.pathname);
const author = { '@type': 'Person', name: SITE.author, url: new URL('/about/', site).href, sameAs: Object.values(SITE.social) };
const schema = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title, description, url, mainEntityOfPage: url,
  datePublished: new Date(article.date).toISOString(),
  ...(article.updatedDate ? { dateModified: new Date(article.updatedDate).toISOString() } : {}),
  inLanguage: lang, author, keywords: article.tags,
} : Astro.url.pathname === '/about/' ? {
  '@context': 'https://schema.org', '@type': 'ProfilePage', url, mainEntity: author,
} : undefined;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, follow" />}
{alternates.map(({ lang, path }) => <link rel="alternate" hreflang={lang} href={new URL(path, site).href} />)}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:image" content={new URL('/teimakes-mark.png', site).href} />
<meta property="og:image:alt" content="teimakes" />
<meta name="twitter:card" content="summary" />
{article && <meta property="article:published_time" content={new Date(article.date).toISOString()} />}
{article?.updatedDate && <meta property="article:modified_time" content={new Date(article.updatedDate).toISOString()} />}
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', site).href} />
<link rel="alternate" type="application/feed+json" title={SITE.title} href={new URL('/feed.json', site).href} />
<link rel="icon" href="/teimakes-mark.png" type="image/png" />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
