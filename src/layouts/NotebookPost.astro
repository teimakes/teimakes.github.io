---
import { SITE } from '../config';
import SeoHead from '../components/SeoHead.astro';
import FeedSubscribe from '../components/FeedSubscribe.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  html?: string;
  date?: string;
  tags?: string[];
  layout?: string;
}

const { title, description, html, date, tags, layout = 'centered' } = Astro.props;
const canonical = Astro.url.pathname.replace('/notebooks/', '/posts/').replace(/-(full|centered)\/?$/, '/');
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonical={canonical} article={date ? { date, tags } : undefined} />
  </head>
  <body class:list={['notebook-page', `layout-${layout}`]}>
    <Header />
    <main class="notebook-main">
      <article class="notebook-article">
        <header class="article-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <a href="/about/" rel="author">{SITE.author}</a>
            {date && <time datetime={new Date(date).toISOString()}>{fmt(new Date(date))}</time>}
            {tags && tags.length > 0 && (
              <span class="post-tags">{tags.map((t: string) => `#${t}`).join(' ')}</span>
            )}
          </div>
        </header>
        <div class="notebook-body" set:html={html} />
      </article>
      <FeedSubscribe />
    </main>
    <Footer />
  </body>
</html>
