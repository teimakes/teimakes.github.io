---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { pageLanguage } from '../lib/seo';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  article?: { date: string; updatedDate?: string; tags?: string[] };
  noindex?: boolean;
}
const lang = Astro.props.lang || pageLanguage(Astro.url.pathname);
---
<!doctype html>
<html lang={lang}>
  <head><SeoHead {...Astro.props} lang={lang} /></head>
  <body>
    <Header />
    <main class="container"><slot /></main>
    <Footer />
  </body>
</html>
